---
layout: base.njk
pagination: {data: pages, size: 1, alias: p}
permalink: "{{ p.prefix }}/tools/crop-input-calculator/{{ p.slug }}/"
tool: crop-input-calculator
eleventyComputed:
  lang: "{{ p.lang }}"
  title: "{{ i18n[p.lang].cropH | replace('{c}', p.name) }}"
  description: "{{ i18n[p.lang].cropD | replace('{c}', p.name) }}"
---
{% set T = i18n[p.lang] %}{% set kind = "crop" %}
<div class="hero"><div class="wrap"><p class="eyebrow">{{ T.eyebrow }}</p><h1>{{ T.cropH | replace('{c}', p.name) }}</h1><p>{{ T.cropL }}</p></div></div>
<section><div class="wrap"><div class="calc" id="app" style="max-width:640px"></div><div id="out"></div><p class="muted">{{ T.disc }}</p><div id="cta"></div></div></section>
{% include "promo.njk" %}
<section><div class="wrap">{% include "toolsbar.njk" %}<h2>{{ T.other }}</h2><ul class="ctry">{% for q in pages %}{% if q.lang == p.lang %}<li><a href="{{ q.prefix }}/tools/crop-input-calculator/{{ q.slug }}/">{{ q.name }}</a></li>{% endif %}{% endfor %}</ul></div></section>
<script>window.T={{ T | dump | safe }};window.CFG={sym:"{{ p.sym }}",lang:"{{ p.lang }}",pre:"{{ p.prefix }}"};</script><script src="/js/crop.js" defer></script>
