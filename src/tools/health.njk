---
layout: base.njk
pagination: {data: langs, size: 1, alias: p}
permalink: "{{ p.prefix }}/tools/health-calendar/"
tool: health-calendar
eleventyComputed:
  lang: "{{ p.code }}"
  title: "{{ i18n[p.code].hcH }}"
  description: "{{ i18n[p.code].hcD }}"
---
{% set T = i18n[p.code] %}{% set kind = "health" %}
<div class="hero"><div class="wrap"><p class="eyebrow">{{ T.eyebrow }}</p><h1>{{ T.hcH }}</h1><p>{{ T.hcL }}</p></div></div>
<section><div class="wrap"><div class="calc" id="app" style="max-width:640px"></div><div id="out"></div><p class="muted">{{ T.disc }}</p></div></section>
{% include "promo.njk" %}
<section><div class="wrap">{% include "toolsbar.njk" %}</div></section>
<script>window.T={{ T | dump | safe }};window.CFG={lang:"{{ p.code }}"};</script><script src="/js/health.js" defer></script>
