---
layout: base.njk
pagination: {data: langs, size: 1, alias: p}
permalink: "{{ p.prefix }}/tools/farm-diary/"
tool: farm-diary
eleventyComputed:
  lang: "{{ p.code }}"
  title: "{{ i18n[p.code].dH }}"
  description: "{{ i18n[p.code].dD }}"
---
{% set T = i18n[p.code] %}{% set kind = "diary" %}
<div class="hero"><div class="wrap"><p class="eyebrow">{{ T.eyebrow }}</p><h1>{{ T.dH }}</h1><p>{{ T.dL }}</p></div></div>
<section><div class="wrap"><div class="calc" id="app" style="max-width:640px"></div><div id="out"></div><p class="muted">{{ T.disc }}</p></div></section>
{% include "promo.njk" %}
<section><div class="wrap">{% include "toolsbar.njk" %}</div></section>
<script>window.T={{ T | dump | safe }};window.CFG={lang:"{{ p.code }}"};</script><script src="/js/diary.js" defer></script>
