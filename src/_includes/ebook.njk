---
layout: base.njk
---
<article><div style="display:grid;gap:24px;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));align-items:start">
{% if cover %}<img src="{{ cover }}" alt="Cover of {{ title }}" class="cover">{% else %}<div class="cover">{{ title }}</div>{% endif %}
<div><h1>{{ title }}</h1><p>{{ summary }}</p><p class="price">&#8358;{{ price }}, instant digital download</p><a class="btn" href="{{ selar }}" rel="noopener">Buy on Selar</a></div></div>
{% if benefits and benefits.length %}<h2>What you will learn</h2><ul>{% for b in benefits %}<li>{{ b }}</li>{% endfor %}</ul>{% endif %}
{{ content | safe }}
{% if faq and faq.length %}<h2>Questions</h2>{% for f in faq %}<details><summary>{{ f.q }}</summary><p>{{ f.a }}</p></details>{% endfor %}{% endif %}
<div class="cta"><p>Questions before you buy? <a href="https://wa.me/{{ site.whatsapp }}">Message us on WhatsApp</a>.</p><a class="btn" href="{{ selar }}" rel="noopener">Buy on Selar</a></div></article>
