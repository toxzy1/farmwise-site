{% set pr = [] %}{% for e in collections.ebooks %}{% if kind in e.data.tools %}{% set pr = (pr.push(e), pr) %}{% endif %}{% endfor %}
{% if pr.length %}<section><div class="wrap"><h2>{{ T.promo }}</h2><div class="grid">{% for e in pr %}<a class="card" href="{{ e.url }}" style="text-decoration:none;color:inherit">{% if e.data.cover %}<img class="cover" src="{{ e.data.cover }}" alt="">{% else %}<div class="cover">{{ e.data.title }}</div>{% endif %}<div class="b"><h3>{{ e.data.title }}</h3><p class="muted">{{ e.data.summary }}</p><span class="price">&#8358;{{ e.data.price }}</span><span class="btn">{{ T.buyit }}</span></div></a>{% endfor %}</div></div></section>{% endif %}
