---
layout: base.njk
title: Free Farm Profit Calculator
description: Free farm profit calculator for African farmers. Enter your costs, yield and price to see profit, ROI and break-even before you plant.
permalink: /calculator/
---
<article style="max-width:720px"><h1>Farm Profit Calculator</h1><p>Enter your own numbers. The calculator shows total cost, expected profit, ROI and break-even for three scenarios.</p>
<div class="calc" id="f">
<label>Country<select id="country">{% for c in countries %}<option value="{{ c.n }}|{{ c.c }}|{{ c.s }}">{{ c.n }} ({{ c.c }})</option>{% endfor %}</select></label>
<label>Crop or livestock<select id="item"><optgroup label="Crops"><option>Tomato</option><option>Pepper</option><option>Bell Pepper</option><option>Cucumber</option><option>Maize</option><option>Watermelon</option><option>Cassava</option><option>Rice</option><option>Soybean</option><option>Beans</option></optgroup><optgroup label="Livestock"><option>Poultry (Broilers)</option><option>Poultry (Layers)</option><option>Cattle/Cow</option><option>Pig</option><option>Fish</option><option>Goats</option></optgroup></select></label>
<label><span id="szl">Farm size (hectares)</span><input id="size" type="number" min="0" step="any" inputmode="decimal"></label>
<label><span id="yl">Expected output per hectare (kg or units)</span><input id="yield" type="number" min="0" step="any" inputmode="decimal"></label>
<label>Selling price per unit<input id="price" type="number" min="0" step="any" inputmode="decimal"></label>
<h2>Production costs (total for your farm)</h2>
<label>Land preparation / housing<input class="cost" type="number" min="0" step="any" inputmode="decimal"></label>
<label>Seed / seedlings / chicks / fingerlings<input class="cost" type="number" min="0" step="any" inputmode="decimal"></label>
<label>Fertilizer / feed<input class="cost" type="number" min="0" step="any" inputmode="decimal"></label>
<label>Chemicals / medication<input class="cost" type="number" min="0" step="any" inputmode="decimal"></label>
<label>Labour<input class="cost" type="number" min="0" step="any" inputmode="decimal"></label>
<label>Transport, water, other<input class="cost" type="number" min="0" step="any" inputmode="decimal"></label>
<p class="muted" id="def"></p></div>
<div id="out"></div><div id="sell"></div>
<p class="muted">All figures are estimates based on what you enter. They are not guaranteed returns. Actual results depend on weather, markets, disease and management.</p></article>
<script>
const DEF={{ calcDefaults | dump | safe }},EB={{ ebooksJson | safe }};
const $=i=>document.getElementById(i),L=['Land','Seed','Fert','Chem','Lab','Oth'];
const livestock=['Poultry (Broilers)','Poultry (Layers)','Cattle/Cow','Pig','Fish','Goats'];
function sym(){return $('country').value.split('|')[2]}
function fmt(n){return isFinite(n)?sym()+Math.round(n).toLocaleString():'-'}
function def(){const k=$('country').value.split('|')[0]+'|'+$('item').value,d=DEF[k],ls=livestock.includes($('item').value);
$('szl').textContent=ls?'Number of animals':'Farm size (hectares)';$('yl').textContent=ls?'Expected output per animal (kg or units)':'Expected output per hectare (kg or units)';
$('def').textContent='';if(d){document.querySelectorAll('.cost').forEach((e,i)=>e.value=d.costs[i]||'');$('yield').value=d.yield||'';$('price').value=d.price||'';$('def').textContent='Reference estimates loaded. Replace them with your own numbers.'}calc()}
function calc(){const s=+$('size').value,y=+$('yield').value,p=+$('price').value,c=[...document.querySelectorAll('.cost')].reduce((a,e)=>a+(+e.value||0),0);
if(!s||!y||!p||!c){$('out').innerHTML='';return}
const sc=[['Conservative',.8,.85],['Expected',1,1],['Optimistic',1.15,1.1]];
let h='<div class="res"><div>Total cost<b>'+fmt(c)+'</b></div><div>Break-even price<b>'+fmt(c/(s*y))+'</b></div><div>Break-even output<b>'+Math.round(c/(s*p)).toLocaleString()+' per unit of size</b></div></div><table><tr><th>Scenario</th><th>Revenue</th><th>Profit</th><th>ROI</th><th>Profit per unit of size</th></tr>';
sc.forEach(([n,fy,fp])=>{const r=s*y*fy*p*fp,pr=r-c;h+='<tr><td>'+n+'</td><td>'+fmt(r)+'</td><td class="'+(pr<0?'neg':'')+'">'+fmt(pr)+'</td><td>'+Math.round(pr/c*100)+'%</td><td>'+fmt(pr/s)+'</td></tr>'});
$('out').innerHTML=h+'</table><p class="muted">Conservative: output -20%, price -15%. Optimistic: output +15%, price +10%.</p>';
const m=EB.filter(e=>e.for.includes($('item').value));
$('sell').innerHTML=m.map(e=>'<div class="cta"><b>Learn more: '+e.title+'</b><br><a class="btn" href="'+e.url+'">See the ebook</a></div>').join('')}
document.getElementById('f').addEventListener('input',e=>e.target.id=='country'||e.target.id=='item'?def():calc());def();
</script>
